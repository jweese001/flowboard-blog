# FlowBoard access template for Hermes
# Copy only the keys you actually need into:
#   /Users/jweese/.hermes/.env
# Do NOT commit real secrets.

# Preferred: dedicated low-privilege FlowBoard account
FLOWBOARD_BASE_URL=https://flow.w33s3.com
FLOWBOARD_EMAIL=
FLOWBOARD_PASSWORD=

# Optional, if FlowBoard eventually exposes a safer API-based auth path
FLOWBOARD_API_KEY=
FLOWBOARD_READONLY_TOKEN=

# Optional selectors / project filters for automation
FLOWBOARD_PROJECT_ALLOWLIST=
FLOWBOARD_PROJECT_DENYLIST=

# Optional: explicit local download/cache dirs for pulled artifacts
FLOWBOARD_CACHE_DIR=/Users/jweese/migration-files/flowboard-cache
FLOWBOARD_SCREENSHOT_DIR=/Users/jweese/migration-files/flowboard-screenshots
